msgstr "Ver las distintas actividades de la IATI de forma pormenorizada."

# REVIEWED: 1eee1254cdf9a693
#: ../../index.rst:10
msgid "Search IATI activities using keywords and filters."
msgstr "Buscar actividades de la IATI utilizando palabras clave y filtros."

# REVIEWED: 40b421051db0caf9
#: ../../index.rst:11
msgid ""
"Access summaries of IATI data by reporting organisation or recipient "
"country."
msgstr ""
"Acceder a resúmenes de los datos de la IATI por organización que presenta "
"informes o país receptor."

