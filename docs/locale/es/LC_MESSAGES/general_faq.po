msgid "\\8. Where can I access the classic d-portal theme?"
msgstr "\\8. ¿Dónde puedo acceder al tema clásico de d-portal?"

# REVIEWED: 1681205be4514628
#: ../../general_faq.rst:69
msgid ""
"You can access the classic d-portal theme at https://classic.d-portal.org/."
msgstr ""
